<taf-app:container:ghcr.io/taffish/bakta:1.12.2-r1$@[docker/podman: --platform linux/amd64 --init $(taf_b_fail() { printf >&2 'taf-bakta: %s\n' "$1"; printf -- '--taffish-bakta-invalid-db'; exit 0; }; taf_b_auto="${TAFFISH_BAKTA_DB_AUTO_MOUNT:-1}"; test "$taf_b_auto" != 0 || exit 0; test "$taf_b_auto" = 1 || taf_b_fail 'DB_AUTO_MOUNT must be 0 or 1'; taf_b_root="${TAFFISH_BAKTA_DB_PATH:-}"; if test "${TAFFISH_BAKTA_DB_PATH+x}" != x; then for taf_b_try in "${HOME:-}/.local/share/taffish/databases/bakta/6.0-amr2026-08-07.1" /usr/local/share/taffish/databases/bakta/6.0-amr2026-08-07.1 /opt/taffish/databases/bakta/6.0-amr2026-08-07.1; do if test -e "$taf_b_try" || test -L "$taf_b_try"; then taf_b_root="$taf_b_try"; break; fi; done; fi; if test -z "$taf_b_root" && test "${TAFFISH_BAKTA_DB_PATH+x}" != x; then exit 0; fi; test -n "$taf_b_root" && test -d "$taf_b_root" || taf_b_fail 'missing database root; choose a prepared DB_PATH'; taf_b_root="$(cd "$taf_b_root" && pwd -P)" || taf_b_fail 'cannot resolve database root'; test "$(printf '%s' "$taf_b_root" | tr -d ' \011\012\013\014\015\052\054\072\077\133\135')" = "$taf_b_root" || taf_b_fail 'bind path contains whitespace/reserved characters; use manual bind'; for taf_b_name in manifest.json FILES READY; do test -s "$taf_b_root/$taf_b_name" && test ! -L "$taf_b_root/$taf_b_name" || taf_b_fail 'missing manifest/inventory/READY'; done; taf_b_hash() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi; }; taf_b_a="$(taf_b_hash "$taf_b_root/manifest.json")" || taf_b_fail 'SHA256 tool failed'; taf_b_b="$(taf_b_hash "$taf_b_root/FILES")" || taf_b_fail 'SHA256 tool failed'; test "${taf_b_a%% *} ${taf_b_b%% *}" = "$(cat "$taf_b_root/READY")" || taf_b_fail 'READY checksum mismatch'; test -z "$(find "$taf_b_root" -type l -print)" || taf_b_fail 'resource contains a symlink'; while IFS=' ' read -r taf_b_size taf_b_name; do test -n "$taf_b_size" && test -z "$(printf '%s' "$taf_b_size" | tr -d '0-9')" || taf_b_fail 'invalid inventory size'; test -n "$taf_b_name" && test "${taf_b_name#/}" = "$taf_b_name" && test "${taf_b_name#*..}" = "$taf_b_name" || taf_b_fail 'unsafe inventory path'; test -z "$(printf '%s' "$taf_b_name" | tr -d 'A-Za-z0-9_./+-')" || taf_b_fail 'unsafe inventory characters'; test -f "$taf_b_root/$taf_b_name" || taf_b_fail 'resource member missing'; taf_b_actual="$(wc -c < "$taf_b_root/$taf_b_name" | tr -d ' ')" || taf_b_fail 'cannot read resource member'; test "$taf_b_actual" = "$taf_b_size" || taf_b_fail 'resource member size mismatch'; done < "$taf_b_root/FILES"; printf -- '--volume=%s:/bakta-db:ro' "$taf_b_root")][apptainer: $(taf_b_fail() { printf >&2 'taf-bakta: %s\n' "$1"; printf -- '--taffish-bakta-invalid-db'; exit 0; }; taf_b_auto="${TAFFISH_BAKTA_DB_AUTO_MOUNT:-1}"; test "$taf_b_auto" != 0 || exit 0; test "$taf_b_auto" = 1 || taf_b_fail 'DB_AUTO_MOUNT must be 0 or 1'; taf_b_root="${TAFFISH_BAKTA_DB_PATH:-}"; if test "${TAFFISH_BAKTA_DB_PATH+x}" != x; then for taf_b_try in "${HOME:-}/.local/share/taffish/databases/bakta/6.0-amr2026-08-07.1" /usr/local/share/taffish/databases/bakta/6.0-amr2026-08-07.1 /opt/taffish/databases/bakta/6.0-amr2026-08-07.1; do if test -e "$taf_b_try" || test -L "$taf_b_try"; then taf_b_root="$taf_b_try"; break; fi; done; fi; if test -z "$taf_b_root" && test "${TAFFISH_BAKTA_DB_PATH+x}" != x; then exit 0; fi; test -n "$taf_b_root" && test -d "$taf_b_root" || taf_b_fail 'missing database root; choose a prepared DB_PATH'; taf_b_root="$(cd "$taf_b_root" && pwd -P)" || taf_b_fail 'cannot resolve database root'; test "$(printf '%s' "$taf_b_root" | tr -d ' \011\012\013\014\015\052\054\072\077\133\135')" = "$taf_b_root" || taf_b_fail 'bind path contains whitespace/reserved characters; use manual bind'; for taf_b_name in manifest.json FILES READY; do test -s "$taf_b_root/$taf_b_name" && test ! -L "$taf_b_root/$taf_b_name" || taf_b_fail 'missing manifest/inventory/READY'; done; taf_b_hash() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi; }; taf_b_a="$(taf_b_hash "$taf_b_root/manifest.json")" || taf_b_fail 'SHA256 tool failed'; taf_b_b="$(taf_b_hash "$taf_b_root/FILES")" || taf_b_fail 'SHA256 tool failed'; test "${taf_b_a%% *} ${taf_b_b%% *}" = "$(cat "$taf_b_root/READY")" || taf_b_fail 'READY checksum mismatch'; test -z "$(find "$taf_b_root" -type l -print)" || taf_b_fail 'resource contains a symlink'; while IFS=' ' read -r taf_b_size taf_b_name; do test -n "$taf_b_size" && test -z "$(printf '%s' "$taf_b_size" | tr -d '0-9')" || taf_b_fail 'invalid inventory size'; test -n "$taf_b_name" && test "${taf_b_name#/}" = "$taf_b_name" && test "${taf_b_name#*..}" = "$taf_b_name" || taf_b_fail 'unsafe inventory path'; test -z "$(printf '%s' "$taf_b_name" | tr -d 'A-Za-z0-9_./+-')" || taf_b_fail 'unsafe inventory characters'; test -f "$taf_b_root/$taf_b_name" || taf_b_fail 'resource member missing'; taf_b_actual="$(wc -c < "$taf_b_root/$taf_b_name" | tr -d ' ')" || taf_b_fail 'cannot read resource member'; test "$taf_b_actual" = "$taf_b_size" || taf_b_fail 'resource member size mismatch'; done < "$taf_b_root/FILES"; printf -- '--bind=%s:/bakta-db:ro' "$taf_b_root")]>
bakta ::*ARGV*::
