#!/opt/conda/bin/python3
"""Read-only static HTTP service for the local-only official Bakta viewer."""
import argparse
import functools
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
import os
from pathlib import Path
import re
import signal
import sys
import tempfile
from urllib.parse import urlsplit, unquote

WEB = Path('/opt/taffish/bakta/web')

def stopped(sig, frame):
    raise SystemExit(128+sig)

class Handler(SimpleHTTPRequestHandler):
    def log_message(self, fmt, *args):
        print(self.log_date_time_string(), fmt % args, file=self.server.log, flush=True)

    def end_headers(self):
        self.send_header('Content-Security-Policy', "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' blob:; font-src 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; base-uri 'none'")
        self.send_header('X-Content-Type-Options', 'nosniff')
        self.send_header('Referrer-Policy', 'no-referrer')
        self.send_header('Cache-Control', 'no-store')
        super().end_headers()

    def send_head(self):
        host = self.headers.get('Host', '').split(':')[0]
        if host not in ('localhost', '127.0.0.1'):
            self.send_error(403, 'Loopback host required')
            return None
        path = unquote(urlsplit(self.path).path)
        if path == '/':
            path = '/index.html'
        candidate = (WEB/path.lstrip('/')).resolve()
        if '..' in Path(path).parts or not candidate.is_relative_to(WEB) or not candidate.is_file():
            self.send_error(404)
            return None
        if candidate.suffix == '.gz':
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Content-Encoding', 'gzip')
            self.send_header('Content-Length', str(candidate.stat().st_size))
            self.end_headers()
            return candidate.open('rb')
        return super().send_head()

def main():
    signal.signal(signal.SIGINT, stopped)
    signal.signal(signal.SIGTERM, stopped)
    parser = argparse.ArgumentParser(description='Local-only Bakta JSON viewer. No cloud API or upload endpoint.')
    parser.add_argument('--bind', choices=['127.0.0.1','0.0.0.0'], default='127.0.0.1', help='use 0.0.0.0 only inside a loopback-published Docker/Podman container')
    parser.add_argument('--port', type=int, default=8080)
    parser.add_argument('--host-port', type=int, help='actual loopback host port when different from container port')
    parser.add_argument('--ssh-host', default='xjp', help='host name for the printed SSH tunnel example')
    parser.add_argument('--log-dir', type=Path, help='existing private, owned directory on an actual writable bind; default private temporary logs')
    args = parser.parse_args()
    if not 1024 <= args.port <= 65535 or not 1024 <= (args.host_port or args.port) <= 65535:
        parser.error('ports must be 1024..65535')
    if not re.fullmatch(r'[A-Za-z0-9_.@-]+', args.ssh_host) or args.ssh_host.startswith('-'):
        parser.error('invalid SSH host')
    temporary = None
    server = None
    try:
        if args.log_dir:
            root = args.log_dir.resolve(strict=True)
            if not root.is_dir() or root.stat().st_uid != os.geteuid() or root.stat().st_mode & 0o077:
                parser.error('--log-dir must be owned and private (0700)')
        else:
            temporary = tempfile.TemporaryDirectory(prefix='bakta-viewer-')
            root = Path(temporary.name)
        host_port = args.host_port or args.port
        print(f'bakta-viewer starting\nURL: http://127.0.0.1:{host_port}/\n'
              f'SSH: ssh -N -L {host_port}:127.0.0.1:{host_port} {args.ssh_host}\n'
              f'Stop: Ctrl-C\nLog directory: {root}\n'
              'Local-only: no cloud tasks; do not publish unauthenticated ports to the Internet.', flush=True)
        if not (WEB/'index.html').is_file():
            raise RuntimeError('viewer assets missing')
        with tempfile.NamedTemporaryFile(mode='w', prefix='http-', suffix='.log', dir=root, delete=False) as log:
            server = ThreadingHTTPServer((args.bind, args.port), functools.partial(Handler, directory=str(WEB)))
            server.daemon_threads = True
            server.log = log
            print('bakta-viewer ready', flush=True)
            server.serve_forever(poll_interval=0.1)
    finally:
        if server is not None:
            server.server_close()
        print('bakta-viewer stopped', flush=True)
        if temporary is not None:
            temporary.cleanup()

if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print('bakta-viewer: '+str(error), file=sys.stderr)
        sys.exit(1)
